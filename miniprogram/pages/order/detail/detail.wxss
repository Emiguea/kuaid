.status-banner {
  background: #4A90D9;
  color: #fff;
  text-align: center;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.status-text { font-size: 34rpx; font-weight: bold; }

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #666; font-size: 28rpx; }
.info-value { color: #333; font-size: 28rpx; max-width: 60%; text-align: right; }

.action-section { margin-top: 30rpx; }
.btn-cancel {
  background: #fff;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  font-size: 30rpx;
}
