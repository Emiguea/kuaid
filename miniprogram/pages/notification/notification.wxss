.top-action { text-align: right; margin-bottom: 20rpx; }
.notification-card { margin-bottom: 16rpx; }
.notification-card.unread { border-left: 6rpx solid #4A90D9; }
.notif-title { font-size: 30rpx; font-weight: bold; }
.unread-dot { width: 16rpx; height: 16rpx; background: #e74c3c; border-radius: 50%; }
.notif-content { font-size: 26rpx; color: #666; display: block; margin-top: 12rpx; line-height: 1.5; }
.notif-time { font-size: 22rpx; color: #999; display: block; margin-top: 10rpx; }
.empty-tip { text-align: center; padding: 60rpx; color: #999; }
