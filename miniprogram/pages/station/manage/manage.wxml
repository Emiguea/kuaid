<view class="container">
  <view class="card">
    <view class="form-item">
      <text class="form-label">站点名称 *</text>
      <input class="form-input" placeholder="如：菜鸟驿站-南门" value="{{name}}" data-field="name" bindinput="onInput"/>
    </view>
    <view class="form-item">
      <text class="form-label">站点地址 *</text>
      <input class="form-input" placeholder="详细地址" value="{{address}}" data-field="address" bindinput="onInput"/>
    </view>
    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input class="form-input" placeholder="站点联系电话" type="number" value="{{contactPhone}}" data-field="contactPhone" bindinput="onInput"/>
    </view>
  </view>
  <button class="btn-primary" style="margin-top: 30rpx;" bindtap="handleSubmit">{{isEdit ? '保存修改' : '创建站点'}}</button>
</view>
