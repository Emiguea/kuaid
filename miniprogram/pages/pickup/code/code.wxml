<view class="container" wx:if="{{express}}">
  <view class="code-card">
    <text class="code-label">您的取件码</text>
    <text class="code-value">{{express.pickupCode}}</text>
    <view class="code-info">
      <text>快递公司: {{express.company || '快递'}}</text>
      <text>货架号: {{express.shelfNo || '-'}}</text>
      <text>单号: {{express.trackingNo}}</text>
    </view>
    <text class="code-tip">请凭此取件码到快递站点取件</text>
  </view>
</view>
