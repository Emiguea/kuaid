.code-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  margin-top: 60rpx;
}
.code-label { font-size: 28rpx; color: #666; display: block; }
.code-value {
  font-size: 96rpx;
  font-weight: bold;
  color: #e74c3c;
  letter-spacing: 20rpx;
  display: block;
  margin: 40rpx 0;
  padding: 30rpx;
  background: #fff5f5;
  border-radius: 12rpx;
}
.code-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
  margin: 30rpx 0;
  text-align: left;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}
.code-tip { font-size: 24rpx; color: #999; display: block; margin-top: 20rpx; }
