.user-card {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 30rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.role-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.balance-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance-label {
  font-size: 28rpx;
  color: #666;
}

.balance-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #e74c3c;
}

.balance-action {
  font-size: 26rpx;
  color: #4A90D9;
}

.menu-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}
