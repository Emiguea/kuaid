<view class="container">
  <!-- User Info Card -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
      <text class="role-tag">{{userInfo.role === 1 ? '快递员' : '学生'}}</text>
    </view>
  </view>

  <!-- Balance Section -->
  <view class="card balance-card" bindtap="goToBalance">
    <text class="balance-label">账户余额</text>
    <text class="balance-amount">¥{{balance}}</text>
    <text class="balance-action">充值 ></text>
  </view>

  <!-- Menu List -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToNotification">
      <text>消息通知</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToStationManage" wx:if="{{userInfo.role === 1}}">
      <text>站点管理</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="applyForCourier" wx:if="{{userInfo.role === 0}}">
      <text>申请成为快递员</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="handleLogout">
      <text class="text-danger">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
