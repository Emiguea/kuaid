<view class="container">
  <view class="balance-header">
    <text class="balance-label">账户余额 (元)</text>
    <text class="balance-value">{{balance}}</text>
    <button class="recharge-btn" bindtap="goToRecharge">充值</button>
  </view>

  <view class="card">
    <text class="section-title">变动记录</text>
    <view wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-left">
          <text class="record-desc">{{item.description}}</text>
          <text class="record-time">{{item.createdAtText}}</text>
        </view>
        <text class="record-amount {{item.amount >= 0 ? 'text-success' : 'text-danger'}}">{{item.amountText}}</text>
      </view>
    </view>
    <view wx:else class="empty-tip"><text>暂无记录</text></view>
  </view>
</view>
