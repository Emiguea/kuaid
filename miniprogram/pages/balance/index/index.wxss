.balance-header {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}
.balance-label { color: rgba(255,255,255,0.8); font-size: 26rpx; display: block; }
.balance-value { color: #fff; font-size: 64rpx; font-weight: bold; display: block; margin: 20rpx 0; }
.recharge-btn { background: rgba(255,255,255,0.2); color: #fff; border: 2rpx solid rgba(255,255,255,0.5); border-radius: 30rpx; font-size: 28rpx; padding: 12rpx 40rpx; display: inline-block; }
.section-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; }
.record-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.record-item:last-child { border-bottom: none; }
.record-left { display: flex; flex-direction: column; }
.record-desc { font-size: 28rpx; color: #333; }
.record-time { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.record-amount { font-size: 30rpx; font-weight: bold; }
.empty-tip { text-align: center; padding: 40rpx; color: #999; }
