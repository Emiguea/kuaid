.register-btn {
  background: #4A90D9;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  font-size: 32rpx;
}

.express-card {
  margin-bottom: 20rpx;
}

.express-company {
  font-size: 32rpx;
  font-weight: bold;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-0 { background: #fff3cd; color: #856404; }
.status-1 { background: #d4edda; color: #155724; }
.status-2 { background: #f8d7da; color: #721c24; }
.status-3 { background: #e2e3e5; color: #383d41; }

.tracking-no {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
}

.pickup-code {
  font-size: 30rpx;
  color: #e74c3c;
  font-weight: bold;
}

.empty-tip, .loading-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
}
