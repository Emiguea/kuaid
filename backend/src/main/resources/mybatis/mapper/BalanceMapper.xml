<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kuaid.dao.BalanceMapper">

    <resultMap id="BaseResultMap" type="com.kuaid.entity.BalanceRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="type" property="type"/>
        <result column="amount" property="amount"/>
        <result column="before_balance" property="beforeBalance"/>
        <result column="after_balance" property="afterBalance"/>
        <result column="related_order_no" property="relatedOrderNo"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, type, amount, before_balance, after_balance, related_order_no, description, created_at
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM `balance_record`
        WHERE user_id = #{userId}
        ORDER BY created_at DESC LIMIT #{offset}, #{limit}
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*) FROM `balance_record` WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.kuaid.entity.BalanceRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `balance_record` (user_id, type, amount, before_balance, after_balance, related_order_no, description)
        VALUES (#{userId}, #{type}, #{amount}, #{beforeBalance}, #{afterBalance}, #{relatedOrderNo}, #{description})
    </insert>
</mapper>
